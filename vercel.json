{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "serverlessFunctionRegion": "us-east-1",
  "functions": {
    "dist/server/server.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ]
}
